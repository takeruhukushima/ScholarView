---
import '../styles/global.css';
import Header from './Header.svelte';
import Footer from './Footer.svelte';
import { autoLangScript } from '../i18n/auto-lang.mjs';
import { localizePath, switchLangPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'ja' ? 'en' : 'ja';
const altHref = switchLangPath(Astro.url.pathname, otherLang);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<script is:inline set:html={autoLangScript} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{t('meta.title')}</title>
		<meta name="description" content={t('meta.description')} />
		<link rel="alternate" hreflang="ja" href={switchLangPath(Astro.url.pathname, 'ja')} />
		<link rel="alternate" hreflang="en" href={switchLangPath(Astro.url.pathname, 'en')} />
	</head>
	<body class="selection:bg-indigo-100 selection:text-indigo-700">
		<Header client:load lang={lang} altHref={altHref} />

		<main class="relative isolate overflow-hidden pt-14">
			<!-- Background patterns -->
			<div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
				<div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-indigo-200 to-indigo-500 opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
			</div>

			<!-- Hero Section -->
			<section class="mx-auto max-w-5xl px-4 py-24 sm:py-32 text-center">
				<div class="inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50/50 px-4 py-1 text-sm font-semibold text-indigo-600 mb-8">
					{t('hero.badge')}
				</div>
				<h1 class="text-5xl font-black tracking-tight text-slate-900 sm:text-7xl lg:leading-[1.1]">
					{t('hero.titleBefore')}<br /><span class="bg-gradient-to-r from-indigo-600 to-indigo-400 bg-clip-text text-transparent">DeSci</span> {t('hero.titleAfter')}
				</h1>
				<p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-slate-600">
					{t('hero.lead1')}<br class="hidden sm:block" />
					{t('hero.lead2')}
				</p>
				<div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href={localizePath('/introduction/', lang)} class="btn-primary w-full sm:w-auto">
						{t('hero.readDocs')} &rarr;
					</a>
					<a
						href="https://github.com/takeruhukushima/ScholarView"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center px-8 py-3 text-sm font-bold text-slate-700 hover:text-indigo-600 transition-colors w-full sm:w-auto"
					>
						{t('hero.viewGithub')} <span aria-hidden="true" class="ml-2">→</span>
					</a>
				</div>
			</section>

			<!-- Features Grid -->
			<section class="mx-auto max-w-5xl px-4 py-24 border-t border-slate-100/50">
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
					<div class="glass-card">
						<div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-100">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-slate-900">{t('feature.atproto.title')}</h3>
						<p class="mt-3 text-slate-600 leading-relaxed text-sm">{t('feature.atproto.body')}</p>
					</div>

					<div class="glass-card">
						<div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-100">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-slate-900">{t('feature.oss.title')}</h3>
						<p class="mt-3 text-slate-600 leading-relaxed text-sm">{t('feature.oss.body')}</p>
					</div>

					<div class="glass-card">
						<div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-100">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-slate-900">{t('feature.desci.title')}</h3>
						<p class="mt-3 text-slate-600 leading-relaxed text-sm">{t('feature.desci.body')}</p>
					</div>

					<div class="glass-card">
						<div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-100">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-slate-900">{t('feature.editor.title')}</h3>
						<p class="mt-3 text-slate-600 leading-relaxed text-sm">{t('feature.editor.body')}</p>
					</div>
				</div>
			</section>
		</main>

		<Footer lang={lang} />
	</body>
</html>
